# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# lock files (keeping bun.lockb only)
package-lock.json
yarn.lock
pnpm-lock.yaml

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — one per client / per deploy, each holding that client's database
# password, Payload secret and R2 keys. Ignore every variant, then re-include the
# committed template. Without the wildcard a file like `.env.cliente1` would be
# tracked and its credentials pushed to the remote.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload CMS
payload.db
payload.db-wal
payload.db-shm
.db-backups/
payload-types.ts
.payload/

# Stray Redis dump artifact
dump.rdb

# graphify output — vive fuera del repo (~/.claude/projects/.../graphify-out),
# aquí es solo un symlink que no se commitea.
graphify-out

# maplibre-gl worker copiado desde node_modules por `bun run maplibre:worker`
/public/maplibre/
