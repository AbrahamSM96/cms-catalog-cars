# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# lock files (keeping bun.lockb only)
package-lock.json
yarn.lock
pnpm-lock.yaml

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload CMS
payload.db
payload.db-wal
payload.db-shm
.db-backups/
payload-types.ts
.payload/

# Stray Redis dump artifact
dump.rdb

# graphify output — vive fuera del repo (~/.claude/projects/.../graphify-out),
# aquí es solo un symlink que no se commitea.
graphify-out
