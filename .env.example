# Payload CMS Secret Key (generate a strong random value in production)
PAYLOAD_SECRET=your-secret-key-here

# Database (Postgres)
# Local dev with Docker Compose (host -> container):
DATABASE_URI=postgres://payload:payload@localhost:5433/cms_catalog_cars

# Postgres credentials consumed by docker-compose.yml
# Host port is 5433 to avoid clashing with other local Postgres instances.
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=cms_catalog_cars
POSTGRES_PORT=5433

# Cloudinary Configuration
# Obtén tus credenciales en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Public Environment Variables (accessible in browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Site URL (used for canonical URLs, sitemap and metadata)
NEXT_PUBLIC_SITE_URL=https://tudominio.com
