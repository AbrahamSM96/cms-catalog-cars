# =============================================================================
# Plantilla de entorno — un archivo por cliente / por deploy.
#
#   cp .env.example .env   (luego rellena los valores de abajo)
#
# El .env NUNCA se sube al repo (está en .gitignore). Genera uno nuevo para
# cada agencia: secreto, base de datos y almacenamiento son propios de cada una.
#
# OJO: la MARCA del cliente (nombre, tagline, colores, textos SEO) NO va aquí.
# Eso se configura en código, en:  app/src/config/site.ts
# Este archivo es solo infraestructura (secretos, DB, imágenes, dominio).
# =============================================================================


# --- Payload -----------------------------------------------------------------
# Secreto para firmar sesiones y tokens del admin. Uno ÚNICO por deploy.
# Genera uno con:  openssl rand -base64 32
#
# OBLIGATORIA en producción: si falta, la app NO arranca (lanza un error en
# payload.config.ts). Antes caía a un valor por defecto que está en el repo, y
# con él cualquiera puede firmarse un token de admin.
PAYLOAD_SECRET=


# --- Base de datos (Postgres) ------------------------------------------------
# PRODUCCIÓN (recomendado: Neon — https://neon.tech). Usa la connection string
# con SSL que te da el proveedor, por ejemplo:
#   postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URI=

# DESARROLLO LOCAL con Docker Compose (`bun run db:up`): comenta la línea de
# arriba y descomenta esta (coincide con las credenciales de más abajo):
#   DATABASE_URI=postgres://payload:payload@localhost:5433/cms_catalog_cars

# Esquema de la BD.
#
# EN DESARROLLO (NODE_ENV=development) Payload crea/actualiza el esquema en cada
# arranque ("push"), sin tocar archivos de migración. Es lo que usa `bun dev`.
#
# EN PRODUCCIÓN el push está DESACTIVADO por el propio adaptador de Postgres
# (solo hace push si NODE_ENV !== 'production'), sin importar lo que valga esta
# variable. Por eso el esquema de un deploy nuevo lo crean las migraciones de
# ./migrations, que se aplican con `bun run migrate` ANTES de arrancar la app.
# En docker-compose eso lo hace el servicio `migrate`, del que depende `app`.
#
# Solo tiene sentido definirla para desactivar el push en desarrollo:
#   PAYLOAD_DB_PUSH=false

# Credenciales que consume docker-compose.yml (SOLO para el Postgres local).
# El puerto es 5433 para no chocar con otros Postgres locales.
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=cms_catalog_cars
POSTGRES_PORT=5433


# --- Almacenamiento de imágenes (Cloudflare R2) ------------------------------
# R2 es S3-compatible y sin costo de egress. Crea un bucket por cliente y un
# API token (Access Key / Secret) en el panel de Cloudflare > R2.
#
# Endpoint S3 de tu cuenta (reemplaza ACCOUNT_ID):
#   https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# URL PÚBLICA del bucket (expuesta al navegador), sin slash final. Puede ser el
# dominio r2.dev del bucket o un dominio propio conectado a R2. Ejemplos:
#   https://pub-xxxxxxxx.r2.dev
#   https://cdn.midominio.com
NEXT_PUBLIC_R2_PUBLIC_URL=


# --- Sitio -------------------------------------------------------------------
# Dominio público del cliente. Se usa en canonical URLs, sitemap y metadata, y
# en producción también como origen de los enlaces que Payload manda por correo
# (el de "restablecer contraseña"). Sin slash final.
#   Producción: https://midominio.com    |    Local: http://localhost:3000
#
# OBLIGATORIA en producción: si falta, la app NO arranca. Es lo que fija el
# dominio de los enlaces de "restablecer contraseña"; sin ella el origen se
# tomaría de la cabecera Host, que la controla quien hace la petición, y el
# token de reseteo acabaría en un enlace hacia el dominio del atacante.
NEXT_PUBLIC_SITE_URL=https://tudominio.com


# --- Analítica ---------------------------------------------------------------
# Proveedor a usar. Vacío = sin analítica. Valores aceptados: umami | google
#
# En local NO cuenta visitas aunque dejes estas variables puestas: la analítica
# solo corre con NODE_ENV=production, y además Umami lleva `data-domains` con el
# host de NEXT_PUBLIC_SITE_URL, así que un build de producción levantado en
# localhost tampoco manda nada.
#
# El código no conoce ningún proveedor en concreto: el sitio pide al registro
# (app/src/lib/analytics/registry.ts) el que diga esta variable. Cambiar de
# Umami a Google Analytics es cambiar esta línea y volver a construir.
#
# OJO: es NEXT_PUBLIC_*, así que se hornea en el build. En Render hay que
# pasarla también como build arg, no solo como variable de runtime.
NEXT_PUBLIC_ANALYTICS_PROVIDER=umami

# --- Umami (si NEXT_PUBLIC_ANALYTICS_PROVIDER=umami) ---
# ID del sitio en Umami. UNO POR CLIENTE: cada agencia tiene su propio sitio en
# el panel y nadie ve el tráfico de otra. Se saca en cloud.umami.is > Settings >
# Websites > el sitio > "Website ID".
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Solo si se auto-hospeda Umami. Por defecto usa la nube:
#   NEXT_PUBLIC_UMAMI_SRC=https://analytics.midominio.com/script.js

# --- Google Analytics 4 (si NEXT_PUBLIC_ANALYTICS_PROVIDER=google) ---
# Measurement ID con formato G-XXXXXXXXXX. Si no cuadra con ese formato, el
# proveedor no renderiza nada (evita romper el script inline con un typo).
#
# GA4 usa cookies: al activarlo hace falta banner de consentimiento y ajustar el
# aviso de privacidad. Umami no.
NEXT_PUBLIC_GA_MEASUREMENT_ID=


# --- Correo saliente (Resend) ------------------------------------------------
# Necesario para que funcione "¿Olvidaste tu contraseña?" en /admin. Si falta
# la API key o la dirección remitente, Payload NO envía nada: solo escribe en
# el log "Email attempted without being configured" y el enlace nunca llega.
#
# Se usa la API HTTP de Resend (puerto 443), no SMTP. Render bloquea el tráfico
# saliente a los puertos SMTP 25, 465 y 587 en los servicios web gratuitos (el
# 25 está bloqueado en todos los planes), así que un transporte SMTP muere con
# ETIMEDOUT antes del handshake. HTTPS nunca se bloquea.
#
# La API key se crea en https://resend.com/api-keys (empieza con "re_").
RESEND_API_KEY=

# Remitente que ve el usuario. OJO: el dominio tiene que estar verificado en
# Resend (registros SPF/DKIM), o la API rechaza el envío.
EMAIL_FROM_ADDRESS=no-reply@tudominio.com
EMAIL_FROM_NAME=Nombre de la agencia
