{
  "name": "cms-catalog-cars",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "maplibre:worker": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/",
    "predev": "bun run maplibre:worker",
    "dev": "next dev",
    "prebuild": "bun run maplibre:worker",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "catalog:cookie": "bun run scripts/capture-catalog-cookie.ts",
    "catalog:scrape": "bun run scripts/scrape-vehicle-catalog.ts",
    "clean": "rm -rf node_modules .next coverage tsconfig.tsbuildinfo .turbo .swc && bun install",
    "reinstall:hard": "bun run clean && rm -f bun.lock && bun pm cache rm && bun install",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "docker:app": "docker compose --profile app up --build",
    "migrate:create": "payload migrate:create",
    "migrate": "NODE_ENV=production payload migrate",
    "seed": "NODE_ENV=production payload run app/src/seed/run.ts",
    "seed:dev": "payload run app/src/seed/run.ts",
    "lint": "oxlint . && bunx eslint . && bun run tsc7",
    "tsc7": "./node_modules/typescript-7/bin/tsc --noEmit",
    "lint:fix": "oxlint --fix . && bunx eslint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint:fix && bun run format",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ci": "bun run lint && bun run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1115.0",
    "@maplibre/maplibre-gl-style-spec": "26.4.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/email-resend": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-s3": "3.89.0",
    "@payloadcms/translations": "3.89.0",
    "clsx": "2.1.1",
    "lucide-react": "1.27.0",
    "maplibre-gl": "6.6.0",
    "next": "16.3.5",
    "nextjs-toploader": "3.9.17",
    "payload": "3.89.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/compat": "1.3.2",
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.53.0",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript-eslint/typescript-estree": "8.70.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-jsdoc": "50.6.17",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-oxlint": "1.83.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sort-destructure-keys": "2.0.0",
    "jsdom": "30.0.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
